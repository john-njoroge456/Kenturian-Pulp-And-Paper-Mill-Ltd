# Copy to .env for local use. On a server, set these in the host's dashboard instead.
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
SECURE_SSL=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional overrides for site details (defaults live in mysite/settings.py)
# COMPANY_EMAIL=
# COMPANY_PHONE=
# COMPANY_LOCATION=
# COMPANY_POSTAL_ADDRESS=


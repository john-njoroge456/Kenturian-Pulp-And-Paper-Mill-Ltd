# ---------------------------------------------------------------
# Copy to .env for local use.
# On the server, set these in cPanel -> Setup Python App -> Environment variables.
# Never commit real values (passwords, keys) to Git.
# ---------------------------------------------------------------

# --- Core ---
# server: False
DEBUG=True
# server: long random key (generate with get_random_secret_key)
SECRET_KEY=
# server: kenturian.co.ke,www.kenturian.co.ke
ALLOWED_HOSTS=localhost,127.0.0.1
# server: https://kenturian.co.ke,https://www.kenturian.co.ke
CSRF_TRUSTED_ORIGINS=
# server: True (HTTPS is active)
SECURE_SSL=False
# server: a private, hard-to-guess path
ADMIN_URL=admin/

# --- Database ---
# blank = local SQLite
# server: mysql://USER:PASSWORD@localhost/DBNAME
DATABASE_URL=

# --- Uploaded files ---
# server: /home3/kenturia/public_html/media
# MEDIA_ROOT=
# server: /home3/kenturia/private_media
# PRIVATE_MEDIA_ROOT=

# --- Email ---
# server: mail.kenturian.co.ke
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# server: the company mailbox, e.g. info@kenturian.co.ke
EMAIL_HOST_USER=
# blank = emails print to the terminal
EMAIL_HOST_PASSWORD=
# where staff notifications go; also the "from" address
COMPANY_EMAIL=

# --- Optional site details (defaults live in mysite/settings.py) ---
# COMPANY_PHONE=
# COMPANY_LOCATION=
# COMPANY_POSTAL_ADDRESS=

# --- Who sends and who receives website emails ---
# server: noreply@kenturian.co.ke (the mailbox the site logs in to)
# FROM_EMAIL=
# server: info@kenturian.co.ke,kenturianpaper@gmail.com
# CONTACT_NOTIFY_EMAILS=
# server: sales@kenturian.co.ke,kenturianpaper@gmail.com
# ORDERS_NOTIFY_EMAILS=
# server: careers@kenturian.co.ke,kenturianpaper@gmail.com
# CAREERS_NOTIFY_EMAILS=

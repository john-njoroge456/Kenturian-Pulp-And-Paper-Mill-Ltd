# ---------------------------------------------------------------
# Copy to .env for local use.
# On the server, set these in cPanel -> Setup Python App -> Environment variables.
# Never commit real values (passwords, keys) to Git.
# ---------------------------------------------------------------

# --- Core ---
DEBUG=True                       # server: False
SECRET_KEY=                      # server: long random key (generate with get_random_secret_key)
ALLOWED_HOSTS=localhost,127.0.0.1
                                 # server: kenturian.co.ke,www.kenturian.co.ke
CSRF_TRUSTED_ORIGINS=            # server: https://kenturian.co.ke,https://www.kenturian.co.ke
SECURE_SSL=False                 # server: True (HTTPS is active)
ADMIN_URL=admin/                 # server: a private, hard-to-guess path

# --- Database ---
DATABASE_URL=                    # blank = local SQLite
                                 # server: mysql://USER:PASSWORD@localhost/DBNAME

# --- Uploaded files ---
# MEDIA_ROOT=                    # server: /home3/kenturia/public_html/media
# PRIVATE_MEDIA_ROOT=            # server: /home3/kenturia/private_media

# --- Email ---
EMAIL_HOST=smtp.gmail.com        # server: mail.kenturian.co.ke
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=                 # server: the company mailbox, e.g. info@kenturian.co.ke
EMAIL_HOST_PASSWORD=             # blank = emails print to the terminal
COMPANY_EMAIL=                   # where staff notifications go; also the "from" address

# --- Optional site details (defaults live in mysite/settings.py) ---
# COMPANY_PHONE=
# COMPANY_LOCATION=
# COMPANY_POSTAL_ADDRESS=

# --- Who sends and who receives website emails ---
# FROM_EMAIL=                    # server: noreply@kenturian.co.ke (the mailbox the site logs in to)
# CONTACT_NOTIFY_EMAILS=         # server: info@kenturian.co.ke,kenturianpaper@gmail.com
# ORDERS_NOTIFY_EMAILS=          # server: sales@kenturian.co.ke,kenturianpaper@gmail.com
# CAREERS_NOTIFY_EMAILS=         # server: careers@kenturian.co.ke,kenturianpaper@gmail.com
